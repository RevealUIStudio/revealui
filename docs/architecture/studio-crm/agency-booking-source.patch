@@ -202,3 +202,21 @@ The booking registry itself requires no new secrets. Private fulfillment adds
 the supported content API origin and existing operator device credential to the
 server configuration; missing configuration fails closed. Merge with a merge
 commit. Do not squash.
+
+## Native CRM booking projection
+
+`GET /api/consultation/crm?booking=<canonical-id>` is a read-only, server-to-server
+projection protected by the existing Studio owner bearer. Guests are denied before
+provider reads. It returns `studio-crm-booking-v1` evidence from the existing Calendar
+ledger, including held/paid status, start/end, 1–8 hours at $300 per hour, Stage B mode,
+Stripe/event bindings and persisted refund evidence. Authoritative absence returns
+`status: missing`; provider failure returns an error and must never be interpreted
+as cancellation. Private buyer fields are returned only to the credentialed operator
+consumer and are stored in account-scoped native CRM storage, never Git.
+
+The projection does not book, create Checkout, refund, reschedule, send an invite,
+mail a buyer or grant private material. The action registry and signed Stripe webhook
+remain the owners of those transitions. CRM synchronization requires an explicitly
+selected existing opportunity and verified native Studio operator/account authority.
+Paired implementation: [RevealUI draft #3128](https://github.com/RevealUIStudio/revealui/pull/3128).
+No deployment or production-provider test is authorized by this change.
diff --git a/server/__tests__/crm-booking-source.test.ts b/server/__tests__/crm-booking-source.test.ts
new file mode 100644
index 0000000..36a353d
--- /dev/null
+++ b/server/__tests__/crm-booking-source.test.ts
@@ -0,0 +1,102 @@
+import { describe, expect, it, vi } from 'vitest';
+import type { Booking } from '../../app/lib/consultation-booking';
+import { createMemoryCalendar } from '../consultation-calendar';
+import { handleConsultationRequest } from '../consultation-http';
+
+const booking: Booking = {
+  booking_id: 'existing-booking',
+  start: '2026-10-20T14:00:00.000Z',
+  end: '2026-10-20T17:00:00.000Z',
+  hours: 3,
+  name: 'Example Buyer',
+  email: 'buyer@example.test',
+  company: 'Example Co',
+  stage_b: true,
+  stage_b_fee: 'paid_addon',
+  network_jti: null,
+  status: 'paid_scheduled',
+  expires_at: '2026-10-19T14:00:00.000Z',
+  event_id: 'calendar-event',
+  meet_link: 'https://meet.example.test/example',
+  stripe_session_id: 'cs_example',
+};
+function request(token?: string, method = 'GET') {
+  return new Request('https://studio.example.test/api/consultation/crm?booking=existing-booking', {
+    method,
+    headers: token ? { Authorization: `Bearer ${token}` } : {},
+  });
+}
+describe('owner-only native CRM booking projection', () => {
+  it('denies guest and forged owner sessions before calendar reads', async () => {
+    const calendar = createMemoryCalendar([booking]);
+    const get = vi.spyOn(calendar, 'get');
+    for (const token of [undefined, 'forged'])
+      expect(
+        (
+          await handleConsultationRequest(request(token), {
+            env: { ownerSession: 'owner-token' },
+            calendar,
+          })
+        ).status,
+      ).toBe(403);
+    expect(get).not.toHaveBeenCalled();
+  });
+  it('returns existing schedule, hour count, source status and refund evidence without side effects', async () => {
+    const calendar = createMemoryCalendar([
+      {
+        ...booking,
+        refund: {
+          chargeId: 'ch_example',
+          amountRefunded: 30000,
+          full: false,
+          domainPackReview: 'review_required',
+        },
+      },
+    ]);
+    const schedule = vi.spyOn(calendar, 'schedulePaid'),
+      release = vi.spyOn(calendar, 'release');
+    const response = await handleConsultationRequest(request('owner-token'), {
+      env: { ownerSession: 'owner-token' },
+      calendar,
+    });
+    expect(response.status).toBe(200);
+    expect(response.headers.get('cache-control')).toBe('private, no-store');
+    expect(await response.json()).toMatchObject({
+      contract: 'studio-crm-booking-v1',
+      bookingId: 'existing-booking',
+      status: 'paid_scheduled',
+      hours: 3,
+      refund: { amountRefunded: 30000, full: false },
+    });
+    expect(schedule).not.toHaveBeenCalled();
+    expect(release).not.toHaveBeenCalled();
+  });
+  it('distinguishes authoritative missing records from unavailable providers', async () => {
+    const calendar = createMemoryCalendar();
+    expect(
+      await (
+        await handleConsultationRequest(request('owner-token'), {
+          env: { ownerSession: 'owner-token' },
+          calendar,
+        })
+      ).json(),
+    ).toMatchObject({ status: 'missing' });
+    vi.spyOn(calendar, 'get').mockRejectedValue(new Error('provider unavailable'));
+    expect(
+      (
+        await handleConsultationRequest(request('owner-token'), {
+          env: { ownerSession: 'owner-token' },
+          calendar,
+        })
+      ).status,
+    ).toBe(502);
+  });
+  it('refuses methods that could imply booking mutation', async () =>
+    expect(
+      (
+        await handleConsultationRequest(request('owner-token', 'POST'), {
+          env: { ownerSession: 'owner-token' },
+        })
+      ).status,
+    ).toBe(405));
+});
