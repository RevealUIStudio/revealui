{
  "name": "@revealui/harnesses",
  "version": "0.9.0",
  "description": "AI harness integration — adapters, daemon, workboard coordination, JSON-RPC server.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RevealUIStudio/revealui.git",
    "directory": "packages/harnesses"
  },
  "license": "FSL-1.1-MIT",
  "bin": {
    "revealui-harnesses": "./dist/cli.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@revealui/ai": "workspace:*",
    "@revealui/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@revealui/dev": "workspace:*",
    "@types/node": "^25.9.4",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "default": "./dist/types/index.js"
    },
    "./workboard": {
      "types": "./dist/workboard/index.d.ts",
      "import": "./dist/workboard/index.js",
      "default": "./dist/workboard/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "import": "./dist/content/index.js",
      "default": "./dist/content/index.js"
    },
    "./manager": {
      "types": "./dist/manager/index.d.ts",
      "import": "./dist/manager/index.js",
      "default": "./dist/manager/index.js"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "default": "./dist/storage/index.js"
    },
    "./goals": {
      "types": "./dist/goals/index.d.ts",
      "import": "./dist/goals/index.js",
      "default": "./dist/goals/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "import": "./dist/protocol/index.js",
      "default": "./dist/protocol/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./hotfix": {
      "types": "./dist/hotfix/index.d.ts",
      "import": "./dist/hotfix/index.js",
      "default": "./dist/hotfix/index.js"
    }
  },
  "files": [
    "dist",
    "content-snapshots",
    "LICENSE"
  ],
  "funding": {
    "type": "commercial",
    "url": "https://revealui.com/pro"
  },
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "node dist/cli.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "content:snapshot:check": "vitest run src/__tests__/content-snapshot.test.ts",
    "content:snapshot:write": "tsx scripts/write-content-snapshots.mts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "homepage": "https://revealui.com",
  "author": "RevealUI Studio <founder@revealui.com>",
  "bugs": {
    "url": "https://github.com/RevealUIStudio/revealui/issues"
  },
  "keywords": [
    "revealui",
    "harness",
    "ai",
    "workboard",
    "json-rpc",
    "agent",
    "goals"
  ]
}
