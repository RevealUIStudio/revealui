  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "db:backfill-migrations": "tsx src/scripts/backfill-migrations.ts",
    "db:cleanup": "tsx src/scripts/cleanup-expired.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:setup:studio": "bash systemd/install.sh",
    "db:start:studio:prod": "bash systemd/start-prod.sh",
    "db:stop:studio": "systemctl --user stop drizzle-studio && bash systemd/clear-env.sh",
    "dev": "tsc --watch",
    "generate:all": "pnpm generate:types && pnpm generate:zod && pnpm generate:contracts",
    "generate:contracts": "tsx src/types/generate-contracts.ts",
    "generate:types": "tsx src/types/generate.ts",
    "generate:zod": "tsx src/types/generate-zod-schemas.ts",
    "lint": "biome check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=html --coverage.reporter=text",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/RevealUIStudio/revealui.git",
    "directory": "packages/db"
  },
  "homepage": "https://revealui.com",
  "author": "RevealUI Studio <founder@revealui.com>",
