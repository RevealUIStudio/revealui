{
  "name": "@revealui/engines",
  "version": "0.4.15",
  "private": true,
  "description": "Unified entry point for the five RevealUI business primitives: people, content, offers, payments, agents.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "dependencies": {
    "@revealui/auth": "workspace:*",
    "@revealui/contracts": "workspace:*",
    "@revealui/core": "workspace:*",
    "@revealui/db": "workspace:*",
    "@revealui/services": "workspace:*"
  },
  "optionalDependencies": {
    "@revealui/ai": "workspace:^"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@revealui/dev": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./users": "./src/users/index.ts",
    "./content": "./src/content/index.ts",
    "./products": "./src/products/index.ts",
    "./payments": "./src/payments/index.ts",
    "./agents": "./src/agents/index.ts"
  },
  "scripts": {
    "build": "echo 'Source-only package — consumed via tsconfig paths, no build needed'",
    "dev": "echo 'Source-only package — no watch mode needed'",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
