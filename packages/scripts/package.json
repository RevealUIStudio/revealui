  "dependencies": {
    "@revealui/contracts": "workspace:*",
    "@revealui/core": "workspace:*",
    "@revealui/db": "workspace:*",
    "pg": "catalog:",
    "pgsql-parser": "^18.2.8",
    "jsonc-parser": "^3.3.1",
    "ret": "^0.5.0",
    "@revealui/ts-strada": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
