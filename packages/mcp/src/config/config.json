{
  "_comment": "External MCP adapter launchers (neon/stripe/vercel/playwright/next-devtools). Native first-party servers launch via `revealui-mcp <name>` (packages/mcp/src/cli.ts). This file is the in-repo launcher map; it is not a Cursor-home copy.",
  "_source_of_truth": "packages/mcp/src/config/config.json",
  "_last_synced": "2026-08-28",
  "mcpServers": {
    "vercel": {
      "command": "pnpm",
      "args": ["mcp:vercel"],
      "env": {
        "VERCEL_API_KEY": "${VERCEL_API_KEY}",
        "VERCEL_TOKEN": "${VERCEL_TOKEN}"
      }
    },
    "stripe": {
      "command": "pnpm",
      "args": ["mcp:stripe"],
      "env": {
        "STRIPE_SECRET_KEY": "${STRIPE_SECRET_KEY}"
      }
    },
    "neon": {
      "command": "pnpm",
      "args": ["mcp:neon"],
      "env": {
        "NEON_API_KEY": "${NEON_API_KEY}"
      }
    },
    "playwright": {
      "command": "pnpm",
      "args": ["mcp:playwright"]
    },
    "next-devtools": {
      "command": "pnpm",
      "args": ["mcp:next-devtools"],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "${NEXT_TELEMETRY_DISABLED:-0}"
      }
    }
  }
}
