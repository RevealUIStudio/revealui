{
  "name": "@revealui/tokens",
  "version": "0.1.0",
  "description": "RevealUI design tokens — canonical CSS variables, typed TS export, and brand canon. Zero internal deps.",
  "keywords": [
    "design-tokens",
    "css-variables",
    "oklch",
    "revealui",
    "tokens",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./design-context/MANIFEST.sha256": "./design-context/MANIFEST.sha256",
    "./design-context/brand-meta.json": "./design-context/brand-meta.json",
    "./design-context/tokens.css": "./design-context/tokens.css"
  },
  "files": [
    "dist",
    "design-context"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "catalog:",
    "@revealui/dev": "workspace:*",
    "postcss": "^8.5.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsc && cp src/tokens.css dist/tokens.css",
    "clean": "rm -rf dist",
    "gen:manifest": "node scripts/gen-manifest.cjs",
    "gen:manifest:check": "node scripts/gen-manifest.cjs --check",
    "lint:adherence": "node scripts/adherence-lint.cjs",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RevealUIStudio/revealui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://revealui.com",
  "author": "RevealUI Studio <founder@revealui.com>",
  "bugs": {
    "url": "https://github.com/RevealUIStudio/revealui/issues"
  }
}
