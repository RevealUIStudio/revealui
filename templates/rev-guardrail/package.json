{
  "name": "rev-guardrail",
  "version": "0.0.0",
  "private": true,
  "description": "REV Guardrail agent template + Fleet plugin skeleton. Not a public SKU.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./locks": "./src/locks.ts",
    "./receipt": "./src/receipt.ts",
    "./enforce": "./src/enforce.ts",
    "./agent": "./src/agent-spec.ts"
  },
  "files": [
    "README.md",
    "locks.example.json",
    "agent.json",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@revealui/dev": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
