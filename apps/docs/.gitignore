# Build output
dist/
.vinxi/

# CHIP-3 D5a: the repo-root /docs tree is copied into public/ at build time —
# by apps/docs/scripts/copy-docs.sh (full copy) and the vite docs-copy plugin
# (markdown only). Everything they emit is a generated build artifact and must
# NOT be committed: tracking the copies forces a sync-commit on every /docs edit
# and trips CI's generated-in-sync git-diff gate (see PR #1033). Edit /docs/,
# never public/.
#
# Every subdirectory under public/ is copied from /docs, so ignore them all;
# with the top-level markdown rule this covers the whole artifact set (including
# non-markdown like features/*.yml) and stays correct as /docs gains subdirs.
public/*.md
public/*/

# Hand-authored content that lives in public/ and is NOT copied from /docs —
# keep it tracked. docs-pro/ is canonical Pro documentation served by
# app/routes/ProPage.tsx and validated by scripts/validate/claim-drift.ts.
# (favicons, logos, robots.txt, sitemap.xml, llms.txt, .gitkeep are top-level
#  non-markdown files matched by neither rule above, so they stay tracked.)
!public/docs-pro/
!public/docs-pro/**

# Dependencies
node_modules/

# Environment
.env
.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
.vercel
.env*.local
