{
  "buildCommand": "cd ../.. && pnpm --filter marketing run vercel-build",
  "installCommand": "",
  "framework": "vite",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.revealui.com https://vitals.vercel-insights.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-ancestors 'self' https://admin.revealui.com"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).map",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.revealui.com" }],
      "destination": "https://revealui.com/:path*",
      "permanent": true
    },
    { "source": "/docs", "destination": "https://docs.revealui.com", "permanent": true },
    {
      "source": "/docs/:path*",
      "destination": "https://docs.revealui.com/:path*",
      "permanent": true
    },
    { "source": "/pro", "destination": "/pricing", "permanent": false },
    { "source": "/quote", "destination": "/pricing", "permanent": true },
    { "source": "/calculator", "destination": "/pricing", "permanent": true },
    { "source": "/coming-soon", "destination": "/roadmap", "permanent": true },
    { "source": "/marketplace", "destination": "/roadmap", "permanent": true },
    { "source": "/sponsor", "destination": "/roadmap", "permanent": true },
    {
      "source": "/community",
      "destination": "https://github.com/RevealUIStudio/revealui/discussions",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "community.revealui.com" }],
      "destination": "https://github.com/RevealUIStudio/revealui/discussions",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "community.revealui.com" }],
      "destination": "https://github.com/RevealUIStudio/revealui/discussions",
      "permanent": true
    },
    {
      "source": "/products",
      "destination": "https://docs.revealui.com/revfleet",
      "permanent": true
    },
    {
      "source": "/philosophy",
      "destination": "https://docs.revealui.com/blog/01-why-we-built-revealui",
      "permanent": true
    },
    {
      "source": "/local-ai",
      "destination": "https://docs.revealui.com/local-first",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/for-operators",
      "destination": "/pricing",
      "permanent": true
    },
    {
      "source": "/for-operators/how-it-works",
      "destination": "https://docs.revealui.com/build-your-business",
      "permanent": true
    },
    {
      "source": "/for-operators/managed",
      "destination": "https://docs.revealui.com/roadmap",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "https://docs.revealui.com/blog/16-ui-of-the-future",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "https://docs.revealui.com/blog/:path*",
      "permanent": true
    },
    {
      "source": "/fair-source",
      "destination": "https://docs.revealui.com/fair-source",
      "permanent": true
    },
    {
      "source": "/roadmap",
      "destination": "https://docs.revealui.com/roadmap",
      "permanent": true
    },
    {
      "source": "/claims",
      "destination": "https://docs.revealui.com",
      "permanent": true
    },
    {
      "source": "/sla",
      "destination": "https://docs.revealui.com/sla",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "https://github.com/RevealUIStudio/revealui/security/policy",
      "permanent": true
    },
    {
      "source": "/legal/hipaa",
      "destination": "https://docs.revealui.com",
      "permanent": true
    },
    {
      "source": "/legal/subprocessors",
      "destination": "https://docs.revealui.com",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "https://admin.revealui.com/signup",
      "permanent": true
    },
    {
      "source": "/checkout",
      "missing": [{ "type": "query", "key": "plan" }, { "type": "query", "key": "license" }],
      "destination": "https://admin.revealui.com/signup?plan=pro",
      "permanent": true
    },
    {
      "source": "/checkout",
      "destination": "https://admin.revealui.com/signup",
      "permanent": true
    },
    {
      "source": "/login",
      "destination": "https://admin.revealui.com/login",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
