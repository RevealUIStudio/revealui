# syntax=docker/dockerfile:1
# RevealUI Fleet — API (Hono/Node.js)

# Build stage
FROM node:24-alpine AS build

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
WORKDIR /app

# Install dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/ai/package.json         ./packages/ai/
COPY packages/auth/package.json       ./packages/auth/
COPY packages/cache/package.json      ./packages/cache/
COPY packages/config/package.json     ./packages/config/
COPY packages/contracts/package.json  ./packages/contracts/
COPY packages/core/package.json       ./packages/core/
COPY packages/db/package.json         ./packages/db/
COPY packages/dev/package.json        ./packages/dev/
COPY packages/knowledge-graph/package.json ./packages/knowledge-graph/
COPY packages/mcp/package.json        ./packages/mcp/
COPY packages/openapi/package.json    ./packages/openapi/
COPY packages/paywall/package.json    ./packages/paywall/
COPY packages/resilience/package.json ./packages/resilience/
COPY packages/security/package.json   ./packages/security/
COPY packages/services/package.json   ./packages/services/
COPY packages/setup/package.json      ./packages/setup/
COPY packages/utils/package.json      ./packages/utils/
COPY packages/ts-strada/package.json ./packages/ts-strada/
COPY apps/server/package.json            ./apps/server/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter server...

# Copy source and build
COPY turbo.json tsconfig.json ./
COPY packages ./packages
COPY apps/server  ./apps/server

ENV NODE_ENV=production
ENV SKIP_ENV_VALIDATION=true

RUN pnpm turbo run build --filter=server...

# Create a self-contained deploy directory with only production deps.
# pnpm deploy resolves workspace symlinks (e.g. @revealui/services) into
# a flat, real node_modules — required because tsup's bundle leaves
# external workspace deps unbundled.
RUN pnpm --filter server deploy /app/server-deploy --prod --legacy

# ---------------------------------------------------------------------------
# Migrate stage — one-shot `drizzle-kit migrate` for self-hosted Fleet kits.
# ---------------------------------------------------------------------------
# Reuses the build stage, which already carries drizzle-kit (a @revealui/db
# devDependency, installed by the non-prod `pnpm install` above), the journalled
# SQL in packages/db/migrations/, and drizzle.config.ts. Published as
# ghcr.io/revealuistudio/revealui-migrate and run ONCE by the kit compose
# `migrate` service (gated service_completed_successfully) BEFORE api + admin
# start, so a freshly-stamped kit volume gets its schema. A fresh kit otherwise
# boots with zero tables: migrations never run at app boot, only via this step.
# Idempotent — drizzle records applied migrations in drizzle.__drizzle_migrations,
# so re-running is a no-op. KIT-ONLY; hosted/Vercel migrates via deploy.yml CI.
FROM build AS migrate
WORKDIR /app/packages/db
ENV NODE_ENV=production
# drizzle-kit reads drizzle.config.ts (out=./migrations; dbCredentials.url from
# POSTGRES_URL, supplied by the compose migrate service).
CMD ["pnpm", "exec", "drizzle-kit", "migrate"]

# ---------------------------------------------------------------------------
# Runtime stage — minimal image, production only
# ---------------------------------------------------------------------------
FROM node:24-alpine AS runner

ENV NODE_ENV=production
ENV PORT=3004
# GAP-214 (parity with admin): flip the running container out of
# RevealUIInstance's build-time guard (NODE_ENV=production && !RUNTIME_INIT) so
# any runtime engine init runs onInit rather than being treated as build-time.
# The build still skips onInit because turbo build does not set RUNTIME_INIT.
ENV RUNTIME_INIT=1

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 hono

# Copy built output and the deploy-flattened node_modules.
# Copying apps/server/node_modules directly would carry pnpm's workspace
# symlinks into a stage that has no packages/ to point them at, so Node
# fails ESM resolution on workspace imports at startup.
COPY --from=build --chown=hono:nodejs /app/apps/server/dist          ./dist
COPY --from=build --chown=hono:nodejs /app/server-deploy/package.json ./
COPY --from=build --chown=hono:nodejs /app/server-deploy/node_modules ./node_modules

# Health check (no curl in hardened image — use node)
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3004/health',(r)=>{process.exit(r.statusCode===200?0:1)})"

USER hono

EXPOSE 3004

# Prod entry: index.ts is side-effect-free in production (it's the Vercel
# serverless handler); worker.ts is the long-running entry that calls serve().
CMD ["node", "dist/worker.js"]
