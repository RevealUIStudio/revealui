{
  "$schema_note": "Single source of truth for paths that the security review gate treats as sensitive. An App receipt alone cannot clear these. Edit this file only. security-review-gate.cjs loads it. Do not copy the list into a second module.",
  "classes": [
    {
      "id": "workflows",
      "markers": [".github/workflows/"]
    },
    {
      "id": "actions",
      "markers": [".github/actions/"]
    },
    {
      "id": "auth",
      "markers": [
        "packages/auth/",
        "packages/core/src/auth/",
        "packages/core/src/session",
        "packages/security/src/authorization",
        "middleware/auth",
        "middleware/authorization",
        "routes/auth",
        "api/auth/",
        "access/roles",
        "lib/access/",
        "lib/auth/",
        "/session",
        "/proxy.ts"
      ]
    },
    {
      "id": "migrations",
      "markers": ["packages/db/migrations/"]
    },
    {
      "id": "gate",
      "markers": [
        "scripts/validate/security-review-gate",
        "scripts/validate/receipt-sensitive-paths.json",
        "scripts/validate/security-paths.shared.json"
      ]
    },
    {
      "id": "codeowners",
      "markers": ["CODEOWNERS"]
    },
    {
      "id": "rulesets",
      "markers": [".github/rulesets/", "ruleset.json", "ruleset.yml", "ruleset.yaml"]
    }
  ]
}
