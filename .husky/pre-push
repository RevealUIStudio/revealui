#!/bin/bash
# Husky invokes hooks through sh; parse the complete body under Bash.
if [ -z "$BASH_VERSION" ]; then
  exec /bin/bash -p -e "$0" "$@"
fi
case "$-" in
  *p*) ;;
  *) exec /bin/bash -p -e "$0" "$@" ;;
esac
{
set -euo pipefail
REFS=$(cat)
BRANCH_UPDATE=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  if [[ "$remote_ref" == refs/heads/* ]] && [[ ! "$local_sha" =~ ^0+$ ]]; then
    BRANCH_UPDATE=1
  fi
done <<< "$REFS"

# Tags and deletions add no branch commits. A managed no-op still consumes
# its live admission so the owner can confirm that the installed hook ran.
if [ "$BRANCH_UPDATE" -eq 0 ] && { [ -n "$REFS" ] || ! { : <&3; } 2>/dev/null; }; then
  echo "No branch updates (tags or deletions only); skipping validation."
  exit 0
fi
if [ -n "${NODE_OPTIONS:-}" ] || [ -n "${BASH_ENV:-}" ] || [ -n "${ENV:-}" ]; then
  echo "Push denied: Node or shell startup injection is unsupported for push admission." >&2
  exit 1
fi
ROOT=$(git rev-parse --show-toplevel)
NODE=$(command -v node)
"$NODE" "$ROOT/scripts/git-hooks/push-admission.cjs" verify "$@" <<< "$REFS"
exit $?
}
